@@ -0,0 +1,48 @@
+import { randomUUID } from "node:crypto";
+
+/**
+ * What a member picks when their Account is made: the username people find them by, in Lens's global Namespace, and
+ * the name and bio every community app shows. It's one identity across apps, so it's chosen here, once, and a grant
+ * can't change it. The username is final: only the name and bio can be edited afterwards.
+ */
+export type NewProfile = { username: string; name: string; bio: string };
+
+/**
+ * The launch Namespace's rules for people who aren't its admins (lens-monad-protocol, script/NamespaceDeployer.sol):
+ * a lowercase letter or a digit first, then also `_` and `-`, and at least 4 characters. Reserved usernames can only
+ * be checked on the chain. Lens community apps check the same rules, e.g. Parallax's usernameError.
+ */
+export const MIN_USERNAME_LENGTH = 4;
+const MAX_USERNAME_LENGTH = 64;
+const MAX_NAME_LENGTH = 100;
+const MAX_BIO_LENGTH = 300;
+
+export function usernameError(username: string): string | undefined {
+  if (username.length < MIN_USERNAME_LENGTH) return `Use at least ${MIN_USERNAME_LENGTH} characters.`;
+  if (username.length > MAX_USERNAME_LENGTH) return `Use at most ${MAX_USERNAME_LENGTH} characters.`;
+  if (!/^[a-z0-9]/.test(username)) return "Start with a lowercase letter or a digit.";
+  if (!/^[a-z0-9_-]+$/.test(username)) return "Use only lowercase letters, digits, _ and -.";
+  return undefined;
+}
+
+/** A profile from a form: the username lowercased and trimmed, the name and bio trimmed and cut to length. */
+export function profileFrom(body: Record<string, unknown>): NewProfile {
+  const text = (value: unknown, max: number) => String(value ?? "").trim().slice(0, max);
+  return {
+    username: text(body.username, MAX_USERNAME_LENGTH + 1).toLowerCase(),
+    name: text(body.name, MAX_NAME_LENGTH),
+    bio: text(body.bio, MAX_BIO_LENGTH),
+  };
+}
+
+/**
+ * The Account's metadata: Lens account metadata 1.0.0, inline as a base64 `data:` URI, as community apps on Monad
+ * store it (there's no storage service), so every app reads the name and bio without fetching anything.
+ */
+export function accountMetadataURI(profile: { name: string; bio: string }): string {
+  const lens: Record<string, string> = { id: randomUUID() };
+  if (profile.name) lens.name = profile.name;
+  if (profile.bio) lens.bio = profile.bio;
+  const json = JSON.stringify({ $schema: "https://json-schemas.lens.dev/account/1.0.0.json", lens });
+  return `data:application/json;base64,${Buffer.from(json).toString("base64")}`;
+}
