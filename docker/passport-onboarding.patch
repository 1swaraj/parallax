new file mode 100644
index 0000000..6602bf0
--- /dev/null
+++ b/apps/passport/test/profile.test.ts
@@ -0,0 +1,27 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { accountMetadataURI, profileFrom, usernameError } from "../src/profile.ts";
+
+test("usernames follow the launch Namespace's rules", () => {
+  for (const ok of ["noor", "ada_lovelace", "4ever", "run-club-pune"]) assert.equal(usernameError(ok), undefined, ok);
+  for (const bad of ["ada", "_ada", "-ada", "Ada", "ada lovelace", "ada.eth", "ádâ1"]) assert.ok(usernameError(bad), bad);
+});
+
+test("a profile form is trimmed, its username lowercased, and kept to length", () => {
+  assert.deepEqual(profileFrom({ username: "  Noor_Run ", name: " Noor ", bio: "x".repeat(400) }), {
+    username: "noor_run",
+    name: "Noor",
+    bio: "x".repeat(300),
+  });
+  assert.deepEqual(profileFrom({}), { username: "", name: "", bio: "" });
+});
+
+test("the profile is Lens account metadata, inline, as community apps read it", () => {
+  const uri = accountMetadataURI({ name: "Noor", bio: "" });
+  assert.match(uri, /^data:application\/json;base64,/);
+  const json = JSON.parse(Buffer.from(uri.split(",")[1] as string, "base64").toString());
+  assert.equal(json.$schema, "https://json-schemas.lens.dev/account/1.0.0.json");
+  assert.equal(json.lens.name, "Noor");
+  assert.equal(json.lens.bio, undefined, "an empty bio is left out");
+  assert.match(json.lens.id, /^[0-9a-f-]{36}$/);
+});
diff --git a/docs/design.md b/docs/design.md
index ebddbf5..011b5ba 100644
--- a/docs/design.md
+++ b/docs/design.md
@@ -48,7 +48,9 @@ A **relayer** is a key that submits other people's signed messages and pays the
 
 ## The flows
 
-**First sign-in.** The club sends the member's browser to the Passport. The member types their email, then the 8-digit code. The Passport makes a key in the key store and creates a Lens Account owned by that key, with the registry as its only manager. One transaction, paid by the relayer.
+**First sign-in.** The club sends the member's browser to the Passport. The member types their email, then the 8-digit code, then picks a username and a name. The username is what people find them by in every app, so it is picked once, here, and can't be changed. The Passport makes a key in the key store and has Lens's factory create a Lens Account owned by that key, with the username in Lens's global Namespace, the name and bio as its profile, and the registry as its only manager. One transaction, paid by the relayer.
+
+**Editing the profile.** On their account page the member edits their name and bio, and every app shows the change. The key store sends it from the member's key, the one thing besides grants it may sign for them that touches the Account itself. Apps can't: a grant only passes calls on, and setting an Account's profile takes its owner.
 
 **Connecting an app.** The Passport shows the club's domain and what it is asking for, in plain words. The member taps Allow. The key store signs a grant, the relayer submits it, and the member is sent back to the club with a one-time code. The club's server swaps the code for an ID token, a signed statement from the Passport that says "this is Account 0x…". Nothing else is in it: not the email, not a name.
 
