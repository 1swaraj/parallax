# The indexer of a mirror of Lens Chain (README, Mirror mode): its own service and its own Postgres, apart from the
# launch deployment's indexer. The other settings are .env.example's.

PONDER_MIRROR=true
PONDER_CHAIN_ID=10143

# No archive RPC needed: Account imports are read from their transactions' calldata, which full nodes keep, rather
# than from the chain's state (GET /mirror's accountReads counts the exceptions). On 2026-10-21 the public testnet
# endpoints kept about 15 to 72 days of state (QuickNode ~72, Monad Foundation ~20, Ankr ~15). They limit requests per
# IP, which shared hosts such as Railway share between their tenants: use a keyed endpoint there.
PONDER_RPC_URL=https://testnet-rpc.monad.xyz
# Blocks per eth_getLogs request, the endpoint's limit: about 100 on QuickNode, Monad Foundation, Ankr and dRPC, and
# 1000 on thirdweb (2026-10-21).
PONDER_GET_LOGS_RANGE=100

# Its own Postgres. On Railway: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Followers an author needs for the Everyone timeline, post search and the trends, once the mirror has follows: Lens
# Chain's spam farms have none. 0 shows everyone.
# MIRROR_TIMELINE_MIN_FOLLOWERS=1

# Offchain metadata, read when posts and Accounts are served: on in mirror mode. The gateways end with /.
# OFFCHAIN_METADATA=true
# METADATA_DEADLINE_MS=2500
# GROVE_GATEWAY=https://api.grove.storage/
# IPFS_GATEWAY=https://ipfs.io/ipfs/
# ARWEAVE_GATEWAY=https://arweave.net/

INDEXER_RATE_LIMIT_PER_MINUTE=600
