# The indexer's environment. Ponder loads .env.local: copy this file there for local runs.

# Chain to index: 31337 (local node, the default), 10143 (Monad testnet) or 143 (Monad mainnet). Its address book
# must be in @lens-monad/protocol (packages/protocol/deployments/<chainId>.json).
PONDER_CHAIN_ID=10143

# HTTP RPC URL(s), comma-separated to spread the load. Required off the local node.
# Production needs a paid RPC: Monad's public testnet RPC (https://testnet-rpc.monad.xyz) answers 429 above
# 25 requests/s per IP, and refuses eth_getLogs over more than 100 blocks. It's fine for a trial run.
PONDER_RPC_URL=https://testnet-rpc.monad.xyz

# Blocks per eth_getLogs request (default 100, the public testnet RPC's limit). Set it to your RPC's limit, not above:
# Ponder then fails on range errors instead of retrying with smaller ranges.
PONDER_GET_LOGS_RANGE=100

# Postgres, required in production. Unset, Ponder uses PGlite in .ponder/ (local development only).
# On Railway: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# The Postgres schema `ponder start` writes to. On Railway, the start command passes --schema $RAILWAY_DEPLOYMENT_ID
# instead: each deployment indexes into a new schema, and takes over once /ready answers 200 (historical indexing
# done), so a deployment has no downtime. The RPC cache (schema ponder_sync) is shared, so re-indexing is fast. Drop
# the schemas of old deployments with `ponder db prune`. Run a single replica: one schema has one writer.
# DATABASE_SCHEMA=lens

# Image ids (0x…, comma-separated) /media refuses to serve, with a 451: takedowns. The bytes stay on-chain.
# MEDIA_BLOCKLIST=

# GraphQL at /graphql, for exploring the data: off unless true. Keep it off in production: its queries aren't bounded
# like the REST API's.
# ENABLE_GRAPHQL=true

# PONDER_LOG_LEVEL=info
