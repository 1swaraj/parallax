# The read-only client of a mirror of Lens Chain (README, Mirror mode): its own Vercel project and its own database,
# apart from the writable testnet Parallax. It sends no transactions: no relayer keys, router or gas budget.
NEXT_PUBLIC_MIRROR=true
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_APP_URL=
RPC_URL=https://testnet-rpc.monad.xyz
# The mirror's indexer (PONDER_MIRROR=true), not the launch deployment's.
INDEXER_URL=

# Sessions, for the optional wallet sign-in. With DATABASE_URL, also /setup and /admin, to moderate what it shows.
SESSION_SECRET=
INSTANCE_SECRET=
SETUP_TOKEN=
DATABASE_URL=
HEALTH_TOKEN=

# Nothing to sponsor. The server refuses writes in mirror mode anyway.
RELAY_PAUSED=true
