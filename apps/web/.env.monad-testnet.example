# Copy settings into the web deployment. Set chain ID before building; URLs are runtime overrides. For the wizard, set DATABASE_URL and INSTANCE_SECRET, then visit /setup.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadscan.com
NEXT_PUBLIC_APP_URL=
RPC_URL=https://testnet-rpc.monad.xyz
INDEXER_URL=
INSTANCE_SECRET=
SETUP_TOKEN=
CRON_SECRET=
SESSION_SECRET=
DATABASE_URL=
HEALTH_TOKEN=

# Initial handoff: there are no active relayers. Choose wallet-paid mode in the UI.
RELAY_PAUSED=true
RELAYER_PRIVATE_KEYS=
SPONSOR_GAS_BUDGET_PER_HOUR=
# Configure these later alongside funded, allowlisted relayers, then set RELAY_PAUSED=false.
SPONSOR_MAX_GAS_PER_TX=1500000
SPONSOR_MAX_GAS_PER_SIGNUP=3000000
SPONSOR_MAX_GAS_PER_IMAGE_POST=2500000
SPONSOR_MAX_GAS_PER_MEDIA_CHUNK=3200000
SPONSOR_MEDIA_CHUNKS_PER_DAY=20

# Light mode: one Vercel project + its own Neon/Postgres; INDEXER_URL is a shared read-only indexer.
INSTANCE_SECRET=
SETUP_TOKEN=
# Deploy an independent router with pnpm instance:deploy-router, then set this override.
SPONSOR_ROUTER_ADDRESS=
