# Parallax, a Lens client on Monad: the web app's environment (Vercel in production). Locally, copy to .env.local.
# On chain 31337 everything has a working default. On 10143 and 143, the secrets below must be set.

# Chain the app runs on: 31337 (local, `pnpm chain`), 10143 (Monad testnet) or 143 (Monad mainnet).
# Its Lens address book must be in packages/protocol/deployments. Read at build time too.
NEXT_PUBLIC_CHAIN_ID=31337
# The RPC browsers use. Public: don't put an API key here, unless the provider restricts it to your domain.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# The app's public URL, e.g. https://parallax.example. Sign-in messages must name its host (without it, the request's
# Host header). On Vercel, set it for Production only: preview deployments have other hosts. Runtime override; editable in the admin panel when unset.
NEXT_PUBLIC_APP_URL=
# A Reown (WalletConnect) project ID, from dashboard.reown.com: adds "WalletConnect" to sign-in, for phones and wallets
# without a browser extension. Public; add the app's domains to the project's allowlist. Unset, sign-in offers the
# browser's wallets only. Runtime override; editable in the admin panel when unset.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Passkey accounts (mera): "Sign in with a passkey" and "Create an account with a passkey" on the sign-in screens, in
# browsers with WebAuthn. A passkey's PRF output seeds an EOA in the page; passkeys belong to the site's domain. On
# unless false. Read at build time.
NEXT_PUBLIC_PASSKEYS=
# The block explorer the app links to (Settings → Network, the footer), without a trailing path. Defaults to
# Monadscan: https://monadscan.com on 143, https://testnet.monadscan.com on 10143; none on 31337. Runtime override; editable in the admin panel when unset.
NEXT_PUBLIC_EXPLORER_URL=

# Server only. The RPC the relayer and the session checks use, e.g. a paid one with its key in the URL. Defaults to
# NEXT_PUBLIC_RPC_URL. Monad's public testnet RPC answers 429 above 25 requests/s per IP, and serverless functions
# share egress IPs: production needs its own.
RPC_URL=

# The indexer (apps/indexer), proxied under /indexer and read by the server. Required outside chain 31337, and at
# runtime; the /indexer proxy reads the current configuration without rebuilding.
INDEXER_URL=http://127.0.0.1:42069

# Server only. Relayers the SponsorRouter allowlists (RELAYERS in DeployLaunch, or the Safe's setRelayer), funded with
# MON: they pay the gas of sponsored actions. Comma-separated; each Account always goes through the same one (a hash
# of its address, modulo the number of keys), so its actions stay in order. Changing the list moves most Accounts to
# another relayer, which is harmless between actions. RELAYER_PRIVATE_KEY still works for a single key.
# On chain 31337 it defaults to anvil's 4th account.
RELAYER_PRIVATE_KEYS=
# RELAYER_PRIVATE_KEY=

# Server only. Encrypts the session cookie, at least 32 characters. Defaults to a fixed value on chain 31337 only, and
# never on Vercel. INSTANCE_SECRET is used when SESSION_SECRET is absent.
SESSION_SECRET=

# Server only. Postgres for what instances must share: relayer nonces, rate limits, the gas budget and likes (which
# are Parallax's own, off-chain) in schema lens_web, created on first use. Unset, they're in memory, which only chain
# 31337 sponsors with: elsewhere, sponsored actions answer 503 "Parallax can't pay network fees here yet".
# Railway: the Postgres service's DATABASE_PUBLIC_URL, with ?sslmode=require.
DATABASE_URL=
# Connections per instance, plus one per relayer for the nonce locks. Instances x (pool size + relayers) must stay
# under the server's max_connections (100 on Railway), with room for the indexer.
DATABASE_POOL_SIZE=5

# Sponsored actions per account per minute, sign-ups per owner and per IP (IPv6: per /64) per hour, sign-ups in all
# per hour, and likes and unlikes per account per minute.
RELAY_RATE_LIMIT_PER_MINUTE=30
SIGNUP_RATE_LIMIT_PER_HOUR=3
SIGNUP_RATE_LIMIT_PER_IP_PER_HOUR=10
SPONSOR_SIGNUPS_PER_HOUR=200
LIKE_RATE_LIMIT_PER_MINUTE=60

# Gas all relayers may spend per clock hour, in gas units (a sign-up uses ~2.2M, a post ~0.8M). Over it, sponsored
# actions answer 503 until the next hour. Required outside chain 31337: unset, sponsored actions answer 503
# "Parallax can't pay network fees here yet". On chain 31337, unset means no limit (the gas is still counted, see
# /api/health).
SPONSOR_GAS_BUDGET_PER_HOUR=
# The highest gas limit one sponsored transaction may have, for relayed actions (posts, follows, profile edits) and
# for sign-ups. Monad charges the whole limit. Over it, the action answers 400: the user can still pay from their wallet.
SPONSOR_MAX_GAS_PER_TX=1500000
SPONSOR_MAX_GAS_PER_SIGNUP=3000000
# The same for images: a post with one (~1.3M, its metadata is bigger), and each 64 KB chunk of one (~2.9M).
SPONSOR_MAX_GAS_PER_IMAGE_POST=2500000
SPONSOR_MAX_GAS_PER_MEDIA_CHUNK=3200000
# Sponsored image chunks per account per 24 hours: an image is one or two (up to 120 KB), ~7 text posts' gas.
SPONSOR_MEDIA_CHUNKS_PER_DAY=20

# true: /api/relay, /api/signup and /api/profile answer 503 "Parallax isn't paying network fees right now". Users can
# still pay from their wallet. The admin toggle applies within 10 seconds unless this override is set.
RELAY_PAUSED=false

# /api/health is unhealthy (503) when a relayer has less MON than this, or the indexer is this many blocks behind.
RELAYER_MIN_BALANCE_MON=5
INDEXER_MAX_LAG_BLOCKS=50
# Server only. /api/health tells everyone its status alone ({"status":"ok"} or "degraded"); the details (relayers,
# balances, gas, problems) take `Authorization: Bearer <HEALTH_TOKEN>`. Admins can also see them through their SIWE session. The web app's
# end-to-end tests read them: run those with the server's HEALTH_TOKEN.
HEALTH_TOKEN=

# Managed instances: set DATABASE_URL + INSTANCE_SECRET and visit /setup. Keep this key backed up with the DB.
INSTANCE_SECRET=
# First owner claim. Unset: the first boot prints a one-time token to server logs.
SETUP_TOKEN=
# Cron bearer token for operator alerts and optional user digests.
CRON_SECRET=
# Optional overrides. Leave unset to edit branding, network, limits and email through /admin.
APP_URL=
APP_NAME=
APP_TAGLINE=
APP_LOGO_URL=
APP_ICON_URL=
APP_ACCENT_COLOR=
APP_ACCENT_COLOR_DARK=
APP_DEFAULT_THEME=
SPONSOR_ROUTER_ADDRESS=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_DOMAIN=
USER_EMAIL_ENABLED=
CAPTCHA_SECRET=
